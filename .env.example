# ─────────────────────────────────────────────────────────────
# REQUIRED — the server refuses to start without these
# ─────────────────────────────────────────────────────────────

# MongoDB. Use a dedicated database per environment; do not point production
# at a database named `test`.
MONGODB_URI=mongodb://localhost:27017/ravi_zoho

# Signing key for session tokens. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Anyone holding this value can forge a superadmin session.
JWT_SECRET=

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=5000

# Set explicitly to `production` when deploying. Anything else relaxes CORS to
# allow every origin and enables verbose request logging.
NODE_ENV=development

JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# Strongly recommended in production (warned about at boot if missing)
# ─────────────────────────────────────────────────────────────

# AES key for bank account numbers at rest. Without it, payout details cannot
# be encrypted or read back. Rotating it makes existing records undecryptable.
ENCRYPTION_KEY=

# Outbound mail: payslips, approval requests, invitations, password resets.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
COMPANY_NAME=
HR_EMAIL=

# Where uploaded employee documents and receipts are written. In production
# this MUST be a mounted persistent volume — a container filesystem is wiped on
# every redeploy, taking all uploaded documents with it.
UPLOAD_DIR=

# ─────────────────────────────────────────────────────────────
# Frontend URLs (used to build links inside emails)
# ─────────────────────────────────────────────────────────────
WEBSITE_URL=http://localhost:3000
MOBILE_DEEP_LINK=ravizoho://

# ─────────────────────────────────────────────────────────────
# Optional integrations — features degrade quietly if unset
# ─────────────────────────────────────────────────────────────

# Zoho People / Payroll sync
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback
ZOHO_ORG_ID=
ZOHO_REFRESH_TOKEN=
ZOHO_PEOPLE_BASE_URL=https://people.zoho.com/people/api
ZOHO_PAYROLL_BASE_URL=https://payroll.zoho.com/api/v1

# RazorpayX — salary payouts
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=

# Redis — rate limiting and job queues.
# REDIS_URL takes precedence over host/port when set (managed Redis add-ons
# usually provide a single URL).
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
